<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         This file was missing entirely, while profile/ had it — so a debug run
         had no network at all: the VM service could not bind its socket and
         every call to the backend failed. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only. The reference backend in example/backend/ serves
         plain http on localhost, and Android blocks cleartext by default from
         API 28, so a debug run cannot reach it without this. It is scoped to
         the debug source set deliberately: the release manifest has no such
         permission, and a merchant copying this app must not inherit one.

         Your own backend must be https in production — the SDK itself refuses
         a non-https origin at UqpaySdk.init time regardless of this flag. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
