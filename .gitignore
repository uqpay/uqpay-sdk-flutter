# Shippable merchant docs live under doc/ (pub's convention) and ARE
# committed. Everything under the top-level docs/ is internal.
!doc/
# The machine-global ~/.gitignore_global has an unanchored `docs/`, which also
# matches test/docs/ (the README-quickstart and error-table drift tests). Those
# ARE committed: CI's "Docs cannot drift" step runs them.
!test/docs/

# Maintainers' working notes and reference material — never committed.
# Shippable docs (README, CHANGELOG, doc/, ERROR_CODES.md) live outside this
# path and ARE committed.
/docs/

# Local credentials — never committed, never printed.
.env
example/.env
# App-only defines generated by example/tool/app_env.sh (no secrets, but
# machine-specific and derived from .env).
example/app.env

# Dart / Flutter
.dart_tool/
.packages
build/
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store

# Test artefacts
coverage/

# Golden-diff output written by a failed `flutter test`.
test/**/failures/
