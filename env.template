# UQPAY Flutter SDK — environment template
#
# Copy to `.env` and fill in sandbox values:
#
#     cp env.template .env
#
# `.env` is gitignored; this template is committed and must never contain
# real credentials. The reference backend reads it; the example app gets
# only the three app-safe keys, copied into example/app.env:
#
#     example/backend/tool/run.sh       # backend: reads .env, API key included
#     example/tool/app_env.sh           # writes example/app.env (3 keys only)
#     cd example && flutter run --dart-define-from-file=app.env
#
# Never run the app with --dart-define-from-file=../.env: every define in the
# file reaches the Flutter build's generated files and logs, API key included.
#
# Credentials come from the sandbox dashboard at
# https://app-sandbox.uqpaytech.com under Developer → API Keys. The API key is
# displayed only once at creation. Sandbox and production credentials are
# separate and not interchangeable.
#
# WHERE EACH VALUE BELONGS
#
#   The API key belongs ONLY on the merchant backend (`example/backend/`).
#   It is never compiled into the app, never passed as a --dart-define to the
#   Flutter build, and the SDK has no parameter that accepts it. An API key
#   inside an app is a compromise.
#
#   The SDK itself never calls POST /api/v1/connect/token. Your backend
#   exchanges UQPAY_CLIENT_ID + UQPAY_API_KEY there for a short-lived
#   auth_token, creates the payment intent, and hands the app only what the
#   app needs for that one payment.

# Target environment: sandbox | production
# sandbox    → https://api-sandbox.uqpaytech.com
# production → https://api.uqpay.com
# Read by the backend, and by the app via example/app.env.
UQPAY_ENVIRONMENT=sandbox

# Backend-only. Exchanged at POST /api/v1/connect/token for a 30-minute
# auth_token, sent as the x-client-id and x-api-key headers.
UQPAY_CLIENT_ID=
UQPAY_API_KEY=

# App-only (copied into example/app.env). Merchant backend that creates
# payment intents for end-to-end tests. The app talks to this URL; it never
# talks to UQPAY with an API key. The backend listens on 127.0.0.1 only: for an
# Android emulator use http://10.0.2.2:8787; for a physical device start the
# backend with UQPAY_BACKEND_BIND=0.0.0.0 on a trusted network.
# Global Acquiring permits a single active token per merchant — issuing a new
# token immediately invalidates the previous one — so intent creation must be
# owned by one server-side caller rather than performed per-device.
UQPAY_MERCHANT_BACKEND_URL=http://localhost:8787

# Backend-only. Public URL receiving acquiring webhooks during testing. 3DS
# outcomes are delivered by webhook rather than in the confirm response, and
# the webhook — not the client result — is what fulfils an order.
UQPAY_WEBHOOK_URL=

# Connected sub-account id, sent as x-on-behalf-of. Empty for direct
# accounts. Read by the backend, and by the app via example/app.env.
UQPAY_ON_BEHALF_OF=

# Overrides the host derived from UQPAY_ENVIRONMENT. Must be an https origin;
# the SDK rejects anything else at init. Empty unless targeting a non-standard
# environment.
UQPAY_API_BASE_URL_OVERRIDE=

# Backend-only. Reference-backend network settings — leave empty for the safe
# defaults. The reference backend is for local development only; never deploy it.
#
# Interface to listen on. Empty = 127.0.0.1 (this machine only; the iOS
# simulator and the Android emulator via 10.0.2.2 still reach it). Set
# 0.0.0.0 only to test from a physical device on a trusted network: anyone
# who can reach the port can then request the merchant token.
UQPAY_BACKEND_BIND=
# Comma-separated browser origins allowed to call the backend (CORS), e.g.
# http://localhost:*,https://dev.example.com:8443. Empty = http://localhost:*
# and http://127.0.0.1:* (where `flutter run -d chrome` serves the web app).
# A wildcard "*" is refused.
UQPAY_BACKEND_CORS_ORIGINS=
